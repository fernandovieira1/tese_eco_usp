devtools::install_github("max-alletsee/rstudio-themes")
install.packages('devtools')
devtools::install_github("max-alletsee/rstudio-themes")
library(rstudiothemes)
install_rstudio_themes()
install_rstudio_themes(theme = "all_light")
install_rstudio_themes(theme = "all_dark")
View(rstudio_themes)
install.packages(fixest)
## IMPORTAR BIBLIOTECAS
library(tidyverse)
library(fixest)
library(plm)
install.packages("plm")
install.packages("fixest")
library(fixest)
# Instalar pacotes
install.packages(c("readxl",       # Ler arquivos Excel (.xlsx)
"tidyverse",    # Coleção de pacotes para manipulação e visualização de dados
"googledrive",  # Acessar e gerenciar arquivos no Google Drive
"summarytools", # Resumos descritivos de dados
"kableExtra",   # Tabelas HTML/LaTeX bonitas
"psych",        # Análises psicométricas e estatísticas
"officer",      # Criar e manipular documentos Word e PowerPoint
"ggcorrplot",   # Gráficos de correlação
"hrbrthemes",   # Temas gráficos para ggplot2
"viridis",      # Paletas de cores para gráficos
'stringr',      # Manipulação de strings
'caret',        # Machine Learning
'shiny',        # Aplicativos web interativos
'stargazer',    # Gerar tabelas resumo
dependecies = TRUE
))
## Dfs, tabelas e gráficos
library(tidyverse)
library(summarytools)  # Resumos descritivos de dados
library(kableExtra)    # Tabelas HTML/LaTeX bonitas
library(stargazer)     # Gerar tabelas resumo
library(hrbrthemes)    # Temas gráficos para ggplot2
library(ggcorrplot)    # Gráficos de correlação
# Efeitos fixos simples ou two-way
library(plm)
## Efeitos fixos within
library(fixest)
