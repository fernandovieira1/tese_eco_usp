@incollection{harrisTheoryEnvironmentalExternalities2021,
  title = {The {{Theory}} of {{Environmental Externalities}}},
  booktitle = {Environmental and {{Natural Resource Economics}}},
  author = {Harris, Jonathan M. and Roach, Brian},
  year = 2021,
  edition = {5},
  publisher = {Routledge},
  abstract = {69Many economic activities have significant external effects---impacts on people who are not directly involved in the activity. Pollution from automobile use is an example. The costs of these external impacts are not reflected in market prices, leading to an excessive production of goods with negative externalities and an economically inefficient outcome.                One approach to pollution control is to internalize external costs using a tax that requires producers and consumers of the polluting good to take these costs into account. In general, the use of such a tax will raise the price and reduce the quantity produced of the good, thereby also reducing pollution. In so doing, it shifts the market equilibrium to a socially more desirable result. In theory, a tax that exactly reflects external costs could achieve an economically efficient outcome, but it is often difficult to establish a proper valuation for negative externalities.                Not all externalities are negative. Positive externalities result when economic activities bring benefits to others not directly involved in the transaction. Preservation of open land benefits those who live nearby, often raising their property values. The use of solar energy benefits society as it reduces pollution levels. When a positive externality exists, there is an economic case for a subsidy to increase the market provision of the good.                An alternative to the use of a tax is the assignment of property rights to externalities. If there is a clear legal right either to emit a certain amount of pollution or to prevent others from emitting pollution, a market in ``rights to pollute'' can develop according to the Coase theorem. However, this solution depends on the ability of firms and individuals to trade these pollution rights with relatively low transaction costs. Where large numbers of people are affected, or where the environmental damages are not easy to define in monetary terms, this approach is not effective. It also raises significant questions of equity, because under a market system, the poor generally bear a heavier burden of pollution.}
}

